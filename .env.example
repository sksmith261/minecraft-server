# Copy to .env and fill in your values: cp .env.example .env && chmod 600 .env
# .env is loaded automatically by docker compose. Never commit it.

# RCON console password — generate one: openssl rand -base64 24
RCON_PASSWORD=change-me

# Message shown in the server list
MOTD=A Minecraft Server

# World seed — leave blank for random
SEED=

# Comma-separated player names allowed to join (ENFORCE_WHITELIST is true)
WHITELIST=player1,player2

# Comma-separated server operators (admins)
OPS=
